<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'stormdrive-rods-title'}"
               SetSize="470 420"
               MinSize="470 420"
               Resizable="False">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6">
        <Label Name="StatusLabel" Text="{Loc 'stormdrive-rods-closed'}" StyleClasses="LabelKeyText" />
        <Label Text="{Loc 'stormdrive-rods-header'}" StyleClasses="LabelHeading" />

        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="RodList" Orientation="Vertical" SeparationOverride="6" Margin="0 0 16 0" />
        </ScrollContainer>

        <Label Name="MessageLabel" Text="" />
    </BoxContainer>
</DefaultWindow>
