<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'bluespace-dock-title'}"
                      SetSize="640 520"
                      MinSize="640 360">
    <BoxContainer Orientation="Vertical" Margin="5 0 5 5">
        <!-- Welcome / insert ID -->
        <Label Name="WelcomeLabel"
               Text="{Loc 'bluespace-dock-insert-id'}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               VerticalExpand="True"
               Margin="0 8" />

        <BoxContainer Orientation="Vertical" Name="Contents" Visible="False" VerticalExpand="True">
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <Label Text="{Loc 'bluespace-dock-balance-label'}" StyleClasses="LabelKeyText" />
                <Label Name="BalanceLabel" Text="" />
            </BoxContainer>

            <LineEdit Name="SearchBar"
                      PlaceHolder="{Loc 'bluespace-dock-search-placeholder'}"
                      HorizontalExpand="True"
                      Margin="0 0 0 4" />

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4 0 16 0">
                <Label Text="{Loc 'bluespace-dock-column-name'}"
                       StyleClasses="LabelKeyText"
                       HorizontalExpand="True"
                       MinWidth="120" />
                <Label Text="{Loc 'bluespace-dock-column-model'}"
                       StyleClasses="LabelKeyText"
                       HorizontalExpand="True"
                       MinWidth="100" />
                <Label Text="{Loc 'bluespace-dock-column-options'}"
                       StyleClasses="LabelKeyText"
                       MinWidth="180"
                       HorizontalAlignment="Right" />
            </BoxContainer>

            <ScrollContainer HorizontalExpand="True"
                             VerticalExpand="True"
                             HScrollEnabled="False"
                             SizeFlagsStretchRatio="6">
                <BoxContainer Name="ShipsList"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              VerticalExpand="True" />
            </ScrollContainer>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 6 0 0">
                <Button Name="DockButton"
                        Text="{Loc 'bluespace-dock-dock-current'}"
                        Disabled="True"
                        HorizontalExpand="True"
                        MinHeight="32" />
                <Button Name="SellActiveButton"
                        Text="{Loc 'bluespace-dock-sell'}"
                        Disabled="True"
                        MinWidth="80"
                        MinHeight="32" />
                <Button Name="TargetIdButton"
                        Access="Public"
                        MinWidth="120"
                        HorizontalExpand="True"
                        ClipText="True"
                        MinHeight="32" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
