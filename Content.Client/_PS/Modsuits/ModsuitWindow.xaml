<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'modsuit-window-title'}"
               MinSize="420 460"
               SetSize="420 460">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="ThemeLabel" />
        <Label Name="StatusLabel" />
        <Label Name="ChargeLabel" />
        <Label Name="ComplexityLabel" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="ToggleButton" HorizontalExpand="True" />
            <Button Name="SealButton" HorizontalExpand="True" />
        </BoxContainer>

        <Label Text="{Loc 'modsuit-window-parts'}" />
        <BoxContainer Name="PartsContainer" Orientation="Vertical" SeparationOverride="2" />

        <Label Text="{Loc 'modsuit-window-modules'}" />
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" MinSize="0 100">
            <BoxContainer Name="ModulesContainer" Orientation="Vertical" SeparationOverride="2" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
