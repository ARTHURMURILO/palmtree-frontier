<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'protean-window-title'}"
               MinSize="360 320"
               SetSize="360 320">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="MetalLabel" />
        <Label Name="StatusLabel" />
        <Label Name="LockLabel" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="FoldButton" HorizontalExpand="True" />
            <Button Name="LockButton" HorizontalExpand="True" />
        </BoxContainer>
        <Button Name="EjectButton" />
        <Button Name="ServoButton" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="LowPowerButton" HorizontalExpand="True" />
            <Button Name="HealButton" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
