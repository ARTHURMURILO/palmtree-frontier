<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
                      Title="{Loc 'tactical-console-window-title'}"
                      SetSize="960 640"
                      MinSize="640 480">
    <BoxContainer Orientation="Horizontal">
        <ui:ShuttleNavControl Name="NavRadar"
                              MouseFilter="Stop"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              Margin="4"/>
        <ScrollContainer HScrollEnabled="False"
                         VerticalExpand="True"
                         MinWidth="256"
                         MaxWidth="256"
                         Margin="5 5 0 5">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalAlignment="Top">
                <controls:StripeBack MinSize="48 48">
                    <Label Name="ConditionDisplayLabel"
                           HorizontalAlignment="Center"
                           VerticalExpand="True"/>
                </controls:StripeBack>
                <BoxContainer Orientation="Horizontal" Margin="3">
                    <Label Text="{Loc 'tactical-console-condition'}"/>
                    <OptionButton Name="ConditionOption"
                                  HorizontalExpand="True"/>
                </BoxContainer>
                <BoxContainer Name="ConditionConfirmBox"
                              Orientation="Vertical"
                              Margin="3"
                              Visible="False">
                    <Label Name="ConditionConfirmLabel"
                           HorizontalAlignment="Center"/>
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="ConditionConfirmButton"
                                Text="{Loc 'tactical-console-confirm'}"
                                HorizontalExpand="True"
                                Margin="2"/>
                        <Button Name="ConditionCancelButton"
                                Text="{Loc 'tactical-console-cancel'}"
                                HorizontalExpand="True"
                                Margin="2"/>
                    </BoxContainer>
                </BoxContainer>
                <controls:StripeBack MinSize="48 48">
                    <Label Text="{Loc 'tactical-console-status'}"
                           HorizontalAlignment="Center"
                           VerticalExpand="True"/>
                </controls:StripeBack>
                <Label Name="LockStatusLabel" Margin="3"/>
                <Label Name="MslStatusLabel" Margin="3"/>
                <Label Name="TargetStatusLabel" Margin="3"/>
                <Label Name="WeaponsBlockedLabel"
                       Text="{Loc 'tactical-console-weapons-blocked'}"
                       Modulate="#ff3b3b"
                       Margin="3"
                       Visible="False"/>
                <controls:StripeBack MinSize="48 48">
                    <Label Text="{Loc 'tactical-console-weapons'}"
                           HorizontalAlignment="Center"
                           VerticalExpand="True"/>
                </controls:StripeBack>
                <OptionButton Name="WeaponsOption" Margin="3"/>
                <BoxContainer Orientation="Horizontal" Margin="3">
                    <Label Text="{Loc 'tactical-console-aim'}"/>
                    <OptionButton Name="TargetOption"
                                  HorizontalExpand="True"/>
                </BoxContainer>
                <Button Name="FireButton"
                        Text="{Loc 'tactical-console-fire'}"
                        Margin="3"/>
                <Button Name="FireTorpedoesButton"
                        Text="{Loc 'tactical-console-fire-torpedoes'}"
                        Margin="3"/>
                <CheckBox Name="AutoFireCheck"
                          Text="{Loc 'tactical-console-auto-fire'}"
                          Margin="3"/>
                <CheckBox Name="AutoConditionCheck"
                          Text="{Loc 'tactical-console-auto-condition'}"
                          Margin="3"/>
                <CheckBox Name="AutoRetaliationCheck"
                          Text="{Loc 'tactical-console-auto-retaliation'}"
                          Margin="3"/>
                <Button Name="ClearLockButton"
                        Text="{Loc 'tactical-console-clear-lock'}"
                        Margin="3"/>
                <CheckBox Name="SilentCheck"
                          Text="{Loc 'ship-console-silent'}"
                          Margin="3"/>
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
