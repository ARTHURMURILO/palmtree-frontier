<cartridges:PSBankTransferUiFragment
    xmlns="https://spacestation14.io"
    xmlns:cartridges="clr-namespace:Content.Client._PS.CartridgeLoader.Cartridges"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical"
    HorizontalExpand="True"
    VerticalExpand="True"
    Margin="5">

    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <controls:StripeBack MinSize="48 48" VerticalExpand="False">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0">
                <TextureRect TexturePath="/Textures/Interface/Nano/ntlogo.svg.png"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             MinSize="32 32"
                             Margin="8 0 0 0" />
                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              Margin="8 0"
                              VerticalAlignment="Center">
                    <Label Text="{Loc rix-title}" StyleClasses="LabelHeading" />
                    <Label Text="{Loc rix-subtitle}" StyleClasses="LabelSubText" />
                </BoxContainer>
                <Label Name="AccountLabel"
                       Text="#000000000"
                       StyleClasses="LabelSubText"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0" />
            </BoxContainer>
        </controls:StripeBack>

        <PanelContainer Margin="0 6 0 0">
            <BoxContainer Orientation="Vertical" Margin="8">
                <Label Text="{Loc rix-balance-label}" />
                <RichTextLabel Name="BalanceLabel" Text="..." />
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Margin="0 6 0 0">
            <BoxContainer Orientation="Vertical" Margin="8">
                <Label Text="{Loc rix-transfer-label}" StyleClasses="LabelHeading" />
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" Margin="0 4 0 0">
                    <Label Text="{Loc rix-target-label}" VerticalAlignment="Center" />
                    <LineEdit Name="TargetInput"
                              PlaceHolder="{Loc rix-target-placeholder}"
                              HorizontalExpand="True"
                              MinWidth="120" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" Margin="0 4 0 0">
                    <Label Text="{Loc rix-amount-label}" VerticalAlignment="Center" />
                    <LineEdit Name="AmountInput"
                              PlaceHolder="{Loc rix-amount-placeholder}"
                              HorizontalExpand="True"
                              MinWidth="120" />
                </BoxContainer>
                <Button Name="SendButton"
                        Text="{Loc rix-send}"
                        Disabled="True"
                        HorizontalAlignment="Right"
                        MinSize="100 32"
                        Margin="0 8 0 0" />
                <Label Name="ResultLabel"
                       Text=""
                       HorizontalAlignment="Center"
                       Margin="0 8 0 0" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</cartridges:PSBankTransferUiFragment>
