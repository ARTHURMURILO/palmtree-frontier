supermatter-announcer = Automatic Supermatter Engine

supermatter-examine-integrity =
    It's integrity is [color=yellow]{$integrity}%[/color].

# Palmtree: these lines are read over the Shortband, by the ship's own crew and by whatever is
# close enough to pick the channel up. They are written the way the machine would say them -
# short, factual, no editorialising - instead of the old station-wide drama.
supermatter-warning =
    Crystal integrity {$integrity}%. Heat rejection insufficient.

supermatter-emergency =
    Crystal integrity {$integrity}%. Intervene now.

supermatter-delam-explosion =
    Containment failure imminent. Mode: explosive. T-minus {$seconds}.

supermatter-delam-overmass =
    Containment failure imminent. Mode: gravitational collapse. T-minus {$seconds}.

supermatter-delam-tesla =
    Containment failure imminent. Mode: power surge. T-minus {$seconds}.

supermatter-delam-cascade =
    Containment failure imminent. Mode: resonance cascade. T-minus {$seconds}.

supermatter-delam-countdown =
    T-minus {$seconds}.

supermatter-delam-mode-change =
    Failure mode changed to {$mode}.

supermatter-mode-explosion = explosive
supermatter-mode-singulo = gravitational collapse
supermatter-mode-tesla = power surge
supermatter-mode-cascade = resonance cascade

supermatter-delam-cancel =
    Delamination aborted. Crystal integrity {$integrity}%.

supermatter-tamper-begin =
    You begin carefully cutting a piece off the supermatter crystal...

supermatter-tamper-end =
    You feel the power of a thousand suns laying on your palms. Or is it all the radiation?

supermatter-announcement-cc-tamper =
    Crystal integrity {$integrity}%. Structural damage from an external force.
