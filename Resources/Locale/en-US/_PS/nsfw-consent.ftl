# Palmtree: NSFW age gate (one-time consent prompt + nsfwtoggle command).

nsfw-consent-title = CONSENT

nsfw-consent-body = This server is private, but it hosts adult (18+) content, including sexual roleplay features.

    You are never required, expected, or forced to take part in any of it.

    Your answer is saved to your account. Only an administrator can change it later.

nsfw-consent-accept = I am 18 or above, and wish to see these features

nsfw-consent-decline = I do not wish to see these features

nsfw-consent-must-answer = You must answer the NSFW consent prompt in the lobby before you can ready up.

nsfwtoggle-command-usage = Usage: { $command } <user> <true/false>

nsfwtoggle-command-invalid-value = Invalid value "{ $value }". Expected true or false.

nsfwtoggle-command-no-player = No player named "{ $user }" is online.

nsfwtoggle-command-not-loaded = { $user } preferences have not loaded yet. Try again in a moment.

nsfwtoggle-command-success = NSFW consent for { $user } is now { $state }.

nsfwtoggle-command-enabled = enabled

nsfwtoggle-command-disabled = disabled

nsfwtoggle-command-completion-user = The player whose NSFW consent flag to set.

nsfwtoggle-command-completion-state = true to enable NSFW features, false to disable them.
