# Palmtree: broadcast on the Shortband, signed with the hull's name. The DM originals told the crew
# to abandon the deck and narrated the slag spreading; the machine now just reports its own state.
rbmk-announce-meltdown = CORE MELTDOWN. Reactor vessel breached.
rbmk-announce-blowout = CORE BLOWOUT. Reactor vessel has burst.

# --- RBMK hands-on interactions ---------------------------------------------------------------

rbmk-fuel-too-hot = You cannot insert fuel into the reactor when it is above 20% power.
rbmk-fuel-full = The reactor is already at maximum fuel load.
rbmk-fuel-inserted = The fuel rod slides into the channel and locks.
rbmk-repair-slagged = That reactor is completely slagged. There is nothing left to repair.
rbmk-repair-power = You cannot repair the reactor while it is running above 20% power.
rbmk-repair-seals-intact = The seals are already intact. Further repairs would need a whole new set.
rbmk-repair-needs-welder = The vessel is cracked and worn. Weld the cracks shut before sealing them.
rbmk-repair-sealed = You apply sealant to some of the reactor's worn seals.
rbmk-repair-weld-free = The vessel is free from cracks. Further repairs must be carried out with sealant.
rbmk-repair-welded = You weld together some of the vessel's cracks. This will do for now.

# --- Reactor grilling --------------------------------------------------------------------------

rbmk-grilled-name-1 = grilled { $name }
rbmk-grilled-description-1 = { $description } It has been grilled over a nuclear reactor.
rbmk-grilled-name-2 = heavily grilled { $name }
rbmk-grilled-description-2 = { $description } It has been heavily grilled through the magic of nuclear fission.
rbmk-grilled-name-3 = three-mile nuclear-grilled { $name }
rbmk-grilled-description-3 = { $description } Cooked on a nuclear reactor running at extreme power by some badass engineer.
rbmk-grilled-name-4 = ultimate meltdown grilled { $name }
rbmk-grilled-description-4 = { $description } A grill this perfect is a rare technique only known to a few engineers.

# --- RBMK examine -----------------------------------------------------------------------------

rbmk-examine-slagged = The reactor vessel is a slagged ruin. There is nothing to inspect.
rbmk-examine-new = The seals look factory new, and the vessel is in excellent shape.
rbmk-examine-good = The seals are in good shape and there are no visible cracks in the vessel.
rbmk-examine-worn = The seals are intact but slightly worn. No visible cracks yet.
rbmk-examine-cracked = The vessel is cracked. It needs welding before the seals can be patched.
rbmk-examine-failing = The vessel is badly degraded. This thing is on borrowed time.

rbmk-examine-ports = The coolant inlet is on its west face, the coolant outlet on its east face, and the moderator feed on its north face.
