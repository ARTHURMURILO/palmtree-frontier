# Palmtree: the sides an engine's ports are on, as the crew sees them aboard the ship.
# The camera counter-rotates with the hull, so the grid frame is the screen frame: a port on the
# sprite's left is always on the player's left, no matter which way the ship is pointing.

reactor-side-left = left
reactor-side-right = right
reactor-side-up = up
reactor-side-down = down
